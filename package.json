{
  "name": "agent-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "spike:cline:check": "pnpm --filter @agent-bridge/driver-cline-sdk test",
    "spike:cline:hub": "pnpm --filter @agent-bridge/driver-cline-sdk spike:hub",
    "spike:cline:local": "pnpm --filter @agent-bridge/driver-cline-sdk spike:local",
    "spike:drivers:check": "pnpm --filter @agent-bridge/spike-driver-selection check",
    "spike:driver:opencode": "pnpm --filter @agent-bridge/spike-driver-selection opencode",
    "spike:driver:claude": "pnpm --filter @agent-bridge/spike-driver-selection claude",
    "spike:driver:codex": "pnpm --filter @agent-bridge/spike-driver-selection codex",
    "spike:drivers:repeat": "pnpm --filter @agent-bridge/spike-driver-selection repeat",
    "spike:drivers:report": "pnpm --filter @agent-bridge/spike-driver-selection report",
    "spike:drivers:b:preflight": "pnpm --filter @agent-bridge/spike-driver-selection b:preflight",
    "spike:drivers:b:check": "pnpm --filter @agent-bridge/spike-driver-selection b:check",
    "spike:driver:opencode:b": "pnpm --filter @agent-bridge/spike-driver-selection opencode:b",
    "spike:driver:claude:b": "pnpm --filter @agent-bridge/spike-driver-selection claude:b",
    "spike:drivers:b:collaboration": "pnpm --filter @agent-bridge/spike-driver-selection b:collaboration",
    "spike:drivers:b:report": "pnpm --filter @agent-bridge/spike-driver-selection b:report",
    "spike:drivers:b:cleanup": "pnpm --filter @agent-bridge/spike-driver-selection b:cleanup",
    "test:driver-opencode:b-simulated": "vitest run packages/driver-opencode/tests/opencode-b-simulated.test.ts",
    "test:driver-claude-agent:b-simulated": "vitest run packages/driver-claude-agent/tests/claude-b-simulated.test.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "vitest run tests/e2e --passWithNoTests",
    "test:security": "vitest run tests/security --passWithNoTests",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
